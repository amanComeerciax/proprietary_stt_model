# ============================================================
# Our STT Model — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environments ---
venv/
env/
.venv/
.env/

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Jupyter / Colab ---
.ipynb_checkpoints/
*.ipynb

# --- Model Checkpoints & Weights ---
*.pt
*.pth
*.ckpt
*.bin
*.onnx
checkpoints/
saved_models/

# --- Datasets (do not commit large audio/data files) ---
# The actual audio files live inside these directories.
# They are intentionally ignored because they are too large for Git.
data/raw/
data/processed/

# --- Logs ---
logs/
*.log
runs/
wandb/

# --- Preprocessing temp files ---
*.tmp
*.bak

# --- Misc ---
*.tar.gz
*.zip
*.7z
.env
*.pickle
*.pkl

